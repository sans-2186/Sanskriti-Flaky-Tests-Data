CREATE TABLE `keyword` (  `id` bigint(20) NOT NULL,  `keyword` varchar(200) NOT NULL,  PRIMARY KEY (`id`),  KEY `idx_keyword` (`keyword`)) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='keyword';
