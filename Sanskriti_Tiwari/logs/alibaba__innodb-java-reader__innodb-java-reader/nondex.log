CREATE TABLE `ad_campaign` (  `id` bigint(20) NOT NULL AUTO_INCREMENT,  `user_id` bigint(20) NOT NULL,  `name` varchar(128) NOT NULL,  `budget` mediumint(9) NOT NULL,  `state` smallint(6) NOT NULL,  `create_time` datetime NOT NULL,  `update_time` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,  PRIMARY KEY (`id`),  KEY `idx_user_id` (`user_id`)) ENGINE=InnoDB DEFAULT CHARSET=utf8 COMMENT='ad_campaign';
